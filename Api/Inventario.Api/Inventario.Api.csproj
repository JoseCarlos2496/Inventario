    <ProjectReference Include="..\..\Infraestructura\Inventario.Infraestructura.Repositorio\Inventario.Infraestructura.Repositorio.csproj" />
    <ProjectReference Include="..\..\Infraestructura\Inventario.Infraestructura.Mensajeria\Inventario.Infraestructura.Mensajeria.csproj" />
  </ItemGroup>

</Project>
